---
// The stub that opens the bilty sheet. It sits in the hero's corner on the first screen and in the
// sticky bar after it, never floating over content.
import { consignment, status } from '../lib/bilty';
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<button class:list={['stub', 'field-station', cls]} type="button" popovertarget="bilty-sheet" aria-haspopup="dialog">
  <span class="stub-no">Bilty {consignment}</span>
  <span class="stub-status" data-bilty-status>{status}</span>
</button>

<style>
  .stub {
    display: inline-grid;
    gap: 0.1rem;
    min-height: 3rem;
    padding: 0.45rem 0.8rem;
    text-align: left;
    line-height: 1.15;
    transition: transform var(--t-micro) var(--ease-out);
  }
  .stub-no { font-weight: 800; text-transform: uppercase; letter-spacing: 0.01em; font-size: var(--step-small); white-space: nowrap; }
  .stub-status { font-size: var(--step-small); white-space: nowrap; }
  @media (hover: hover) and (pointer: fine) {
    .stub:hover { transform: translateY(-2px); }
  }
  .stub:active { transform: scale(0.97); }
</style>
