---
// "Also shipped": the smaller things, on a bone field, set as a list in large type.
const items = [
  {
    name: 'Classroom Reminder Bot',
    line: 'Google Classroom deadlines as Slack messages, for $0. Apps Script checks every four hours and schedules each reminder through Slack itself, and a daily heartbeat says when the bot has gone quiet.',
    href: 'https://github.com/iwhozaifa/classroom-reminder-bot',
  },
];
---
<section id="also" class="also field-paper" aria-labelledby="also-h">
  <div class="wrap section grid">
    <h2 id="also-h" class="head also-head">Also shipped</h2>
    <ul class="items" role="list">
      {items.map((it) => (
        <li class="item">
          <a class="item-name link" href={it.href}>{it.name} <span class="arrow" aria-hidden="true">→</span></a>
          <p class="item-line">{it.line}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .also-head { grid-column: 1 / 6; }
  .items { grid-column: 6 / 13; display: grid; gap: 2.5rem; align-content: start; }
  .item-name { font-family: var(--font-display); font-weight: 900; text-transform: uppercase; letter-spacing: -0.03em; font-size: var(--step-lead); line-height: 1.05; text-decoration-color: var(--peacock); }
  .item-line { margin-top: 1rem; font-size: var(--step-lead); line-height: 1.35; max-width: 40ch; }
  @media (max-width: 47.99em) {
    .also-head, .items { grid-column: 1 / -1; }
    .items { margin-top: 2rem; }
  }
</style>
