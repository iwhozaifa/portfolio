---
// First screen: blueprint "Card over a dim room" (taste-skill sheet, seed 4127). A painted tailgate fills
// the screen, dimmed; a turmeric panel over it carries the name, what Ali Huzaifa does, and the one action.
import { Picture } from 'astro:assets';
import tailgate from '../assets/found/tailgate-nathiagali.jpg';
import credits from '../assets/found/credits.json';

const photo = credits.find((c) => c.file.endsWith('tailgate-nathiagali.jpg'))!;
---
<section class="hero" aria-labelledby="hero-title">
  <Picture
    src={tailgate}
    formats={['avif', 'webp']}
    widths={[640, 960, 1440, 1920, 2400]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class="hero-photo"
    alt="The painted back of a goods truck on a road near Nathiagali: a crimson panel with two peacocks above a load of gravel, and a tiger on the mud flap."
  />
  <div class="card field-turmeric" data-hero-card>
    <div class="card-top">
      <h1 id="hero-title" class="name lines">
        <span class="line"><span data-line style="--i: 0">Ali</span></span>
        <span class="line"><span data-line style="--i: 1">Huzaifa</span></span>
      </h1>
      <p class="ur urdu-name" lang="ur" dir="rtl">علی حذیفہ</p>
    </div>
    <div class="card-middle">
      <p class="lead" data-rise style="--i: 3">I build cloud systems on AWS and the pipelines that ship them. Freelance builds welcome.</p>
      <p class="facts" data-rise style="--i: 4">Software engineering student in Pakistan.</p>
    </div>
    <div class="card-bottom">
      <p class="small credit">
        Photo: <a class="link" href={photo.page}>{photo.creator}</a>, <a class="link" href={photo.licenseUrl}>{photo.license}</a>, cropped
      </p>
      <a class="button" href="#contact">Start a project</a>
      <a class="link strong github" href="https://github.com/iwhozaifa">GitHub <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    padding-inline: var(--margin);
    align-items: center;
    overflow: hidden;
    background: var(--night);
  }
  .hero :global(.hero-photo) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 49% 50%;
    filter: brightness(0.7);
  }
  .card {
    position: relative;
    grid-column: 4 / 11;
    min-height: 62svh;
    padding: 2rem;
    display: grid;
    grid-template-rows: auto 1fr auto;
    row-gap: 2rem;
  }
  .card-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; }
  .name { font-size: clamp(3.5rem, 9.5vw, 12rem); line-height: 0.86; letter-spacing: -0.05em; }
  .urdu-name { font-size: var(--step-lead); margin-top: 0.25rem; }
  .card-middle { align-self: end; display: grid; gap: 1rem; }
  .card-middle .lead { max-width: 30ch; font-weight: 700; }
  .card-bottom { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 1rem; }
  .credit { max-width: 24ch; }
  .github { justify-self: end; }

  @media (max-width: 63.99em) {
    .card { grid-column: 2 / 12; }
  }
  @media (max-width: 47.99em) {
    .hero { align-items: center; padding-block: 1rem 5.5rem; }
    .card { grid-column: 1 / -1; min-height: 70svh; padding: 1.25rem; row-gap: 1.5rem; }
    .name { font-size: 19vw; }
    .card-top { flex-direction: column; gap: 0.5rem; }
    .urdu-name { margin-top: 0; }
    .card-bottom { grid-template-columns: 1fr auto; }
    .card-bottom .button { grid-column: 1 / -1; grid-row: 2; width: 100%; min-height: 3.5rem; }
  }
</style>
