---
// The bilty: a consignment slip for this page, written by the pipeline that deployed it
// (scripts/bilty.mjs). This is the sheet; BiltyStub opens it as a popover, with no script.
import { bilty, rows, status } from '../lib/bilty';
---
<div id="bilty-sheet" class="sheet field-paper" popover role="dialog" aria-labelledby="bilty-title" data-repo={bilty.repo} data-workflow={bilty.workflow}>
  <div class="sheet-head">
    <h2 id="bilty-title" class="sheet-title">Bilty for this page</h2>
    <button class="close link strong" type="button" popovertarget="bilty-sheet" popovertargetaction="hide">Close</button>
  </div>
  <dl class="rows nums">
    <div class="row status-row"><dt>Status</dt><dd data-bilty-status>{status}</dd></div>
    {rows.map((r) => (
      <div class="row">
        <dt>{r.label}</dt>
        <dd>{r.href ? <a class="link" href={r.href}>{r.value}</a> : r.value}</dd>
      </div>
    ))}
  </dl>
  <p class="small note">Written by the pipeline that deployed this page.</p>
</div>

<style>
  .sheet {
    position: fixed;
    inset: auto var(--margin) var(--margin) auto;
    margin: 0;
    width: min(26rem, calc(100vw - 2 * var(--margin)));
    max-height: calc(100svh - 2 * var(--margin));
    overflow: auto;
    padding: 1.5rem;
    border: 0;
  }
  .sheet-head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; margin-bottom: 1.25rem; }
  .sheet-title { font-size: var(--step-lead); line-height: 1; letter-spacing: -0.03em; }
  .rows { display: grid; gap: 0.25rem; }
  .row { display: grid; grid-template-columns: 9rem 1fr; gap: 1rem; padding: 0.55rem 0.75rem; background: var(--paper-2); }
  .row dt { font-weight: 700; }
  .status-row { background: var(--night); color: var(--paper); }
  .note { margin-top: 1rem; }
  .sheet::backdrop { background: var(--night); opacity: 0.55; }
</style>

<script>
  // The live part of the bilty: the slip this deploy wrote (/bilty.json) and the latest run of the deploy
  // workflow on GitHub. If either can't be read, the slip built into the page stays as it is.
  const sheet = document.getElementById('bilty-sheet');
  const words: Record<string, string> = { delivered: 'Delivered', 'on-the-road': 'On the road', held: 'Held at checkpost', local: 'Local build' };
  const setStatus = (s: string) => document.querySelectorAll('[data-bilty-status]').forEach((el) => { el.textContent = words[s] ?? s; });
  async function live() {
    if (!sheet || location.hostname === 'localhost' || location.hostname === '127.0.0.1') return;
    try {
      const slip = await fetch('/bilty.json', { cache: 'no-store' }).then((r) => (r.ok ? r.json() : null));
      if (slip?.status) setStatus(slip.status);
      const key = 'bilty-run';
      const cached = sessionStorage.getItem(key);
      const run = cached ? JSON.parse(cached) : await fetch(`https://api.github.com/repos/${sheet.dataset.repo}/actions/workflows/${sheet.dataset.workflow}/runs?per_page=1`, { headers: { Accept: 'application/vnd.github+json' } }).then((r) => (r.ok ? r.json() : null)).then((j) => j?.workflow_runs?.[0] ?? null);
      if (!run) return;
      if (!cached) sessionStorage.setItem(key, JSON.stringify({ status: run.status, conclusion: run.conclusion }));
      if (run.status !== 'completed') setStatus('on-the-road');
      else if (run.conclusion && run.conclusion !== 'success') setStatus('held');
    } catch {
      /* the built-in slip stands */
    }
  }
  live();
</script>
