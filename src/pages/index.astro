---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import SiteNav from '../components/SiteNav.astro';
import WorkPanels from '../components/WorkPanels.astro';
import ShipStage from '../components/ShipStage.astro';
import AlsoShipped from '../components/AlsoShipped.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import Bilty from '../components/Bilty.astro';
---
<Base
  title="Ali Huzaifa · cloud systems and pipelines"
  description="Ali Huzaifa builds cloud systems on AWS and the pipelines that ship them. Case studies, proof and how to start a freelance project."
>
  <main id="main">
    <Hero />
    <SiteNav />
    <WorkPanels />
    <ShipStage />
    <AlsoShipped />
    <About />
    <Contact />
  </main>
  <Footer />
  <Bilty />
</Base>
