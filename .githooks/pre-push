#!/bin/sh
# Changes reach main only through squash-merged pull requests (docs/GIT_WORKFLOW.md).
# Second line of defence behind GitHub branch protection.
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "pre-push: direct pushes to main are not allowed; open a pull request (docs/GIT_WORKFLOW.md)." >&2
    exit 1
  fi
done
exit 0
